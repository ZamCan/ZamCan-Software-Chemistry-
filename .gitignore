# ============================================================
# ZamCan Software Chemistry
# Git Ignore Rules
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
*.egg-info/
build/
dist/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking / linters
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Logs
*.log

# Local environment / secrets
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated scientific artifacts
generated/
output/
cache/

# Generated visualization files
sketches/generated/

# Editor / refactor scratch files
*.bak
*.stage2b
*.pre_temperature_semantics
